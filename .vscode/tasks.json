{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build cpp debug",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-g",
        "-std=c++17",
        "-O0",
        "${workspaceFolder}/debug/cpp/debug.cpp",
        "-o",
        "${workspaceFolder}/debug/cpp/debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
